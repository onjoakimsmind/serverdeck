[Unit]
Description=ServerDeck control panel
Documentation=file://@PREFIX@/current/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=@PREFIX@/current/public/index.php

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@PREFIX@/current
Environment=XDG_CONFIG_HOME=@DATA_DIR@/.config
Environment=XDG_DATA_HOME=@DATA_DIR@/.local/share
Environment=XDG_CACHE_HOME=@DATA_DIR@/.cache
ExecStart=@PREFIX@/current/bin/frankenphp run --config @CONF_DIR@/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=@DATA_DIR@
SyslogIdentifier=serverdeck
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
